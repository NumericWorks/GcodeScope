; SINUMERIK 840D sl flow test
DEF REAL STEP=15
DEF INT CNT
N10 G17 G90 G54 G71
N20 T="DRILL_D6" D1
N30 M6
N40 S3000 M3 F200
N50 G0 Z50
N60 MCALL CYCLE81(50,0,2,-10)
N70 HOLES2(100,100,30,0,0,4)
N80 MCALL
N90 R1=0
N100 LOOP1: R1=R1+1
N110 G0 X=R1*STEP Y0
N120 IF R1<3 GOTOB LOOP1
N130 FOR CNT=1 TO 2
N140 G0 X=CNT*10 Y=-20
N150 ENDFOR
N160 TRANS X200 Y0
N170 AROT RPL=90
N180 CYCLE81(50,0,2,-5)
N190 G0 X10 Y0
N200 CYCLE81(50,0,2,-5)
N210 TRANS
N220 T="MILL_D10" D1
N230 M6
N240 G0 X300 Y0 Z2
N250 G1 Z0 F300
N260 G1 X310 Y0 F800
N270 G3 X310 Y0 Z-6 I=AC(300) J=AC(0) TURN=2
N280 G3 X310 Y0 I-10 J0
N290 G1 X300 Y0
N300 G0 Z50
N310 G0 X400 Y0
N320 G1 Z-1
N330 CIP X420 Y0 I1=410 J1=10
N340 G0 Z50
N350 M30
